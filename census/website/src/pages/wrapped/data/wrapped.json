dba4d51-276d-4d15-8928-a2838679023d.jpg","width":3840,"height":2160,"boundingBox":{"x":1594,"y":861,"width":594,"height":705}},{"nickname":"Band-winged Bee Fly","url":"https://census-storage.alveus.gg/b678280c-08c8-4869-bcae-849df79f4533.jpg","width":3840,"height":2160,"boundingBox":{"x":1416,"y":665,"width":1054,"height":1094}},{"nickname":"Macleay's Owlfly","url":"https://census-storage.alveus.gg/f44b3075-af5b-46cd-a8ed-87ab01e8da10.jpg","width":3840,"height":2160,"boundingBox":{"x":1354,"y":711,"width":1235,"height":1238}},{"nickname":"Sweat Bees","url":"https://census-storage.alveus.gg/09c2177b-d087-468b-afbd-c067c6ebfe03.jpg","width":3840,"height":2160,"boundingBox":{"x":1436,"y":516,"width":1052,"height":1043}},{"nickname":"Click Beetles","url":"https://census-storage.alveus.gg/effdf539-aff4-4ad7-a04a-e8554eba43ed.jpg","width":3840,"height":2160,"boundingBox":{"x":1860,"y":972,"width":1126,"height":946}},{"nickname":"Ruby-throated Hummingbird","url":"https://census-storage.alveus.gg/38c0d39a-643d-48e2-af69-3dee96df9738.jpg","width":3840,"height":2160,"boundingBox":{"x":1526,"y":536,"width":1265,"height":877}},{"nickname":"Prepops","url":"https://census-storage.alveus.gg/fe0abbec-41bb-4a85-bed4-e7c74239cc25.jpg","width":3840,"height":2160,"boundingBox":{"x":1370,"y":618,"width":1390,"height":1114}}],"comments":[{"comment":"White dots in the wings, gravitates towards palm leaf mist flower which is a polular plant for this specimen","username":"aristophat1203","nickname":"Queen"},{"comment":"Has the thick bumpy yellow fluffy band on it's abdomen. A common bee species in the garden.","username":"Mortalized","nickname":"Sonoran Bumble Bee"},{"comment":"Female, light underbelly and grey-brownish top coloration. Fairly long beak and round head shape.","username":"merowzers","nickname":"Ruby-throated and Black-chinned Hummingbirds"},{"comment":"Got more yellow then black so yes I think it must be a Sonoran bumblebee","username":"EleanorGotGame","nickname":"Sonoran Bumble Bee"},{"comment":"Dark spots and there seems to be a break in the ridge at the back of the body","username":"instantmohawk","nickname":"Rio Grande Leopard Frog"},{"comment":"Head pattern consistent with previous observations, The other Phaedrotettix species in Texas are not found in the central portion of the state","username":"Evantomology","nickname":"Phaedrotettix dumicolus"},{"comment":"I agree because these butterflies lack the black forewing line that monarch butterflies have.","username":"gothswine","nickname":"Queen"},{"comment":"shape appears to match that of Mantidflies, hard to identify color since its night","username":"sambanana1","nickname":"Mantidflies"},{"comment":"seven stripes, stopping above the tail, with numerous lighter spots within the dark spaces between the stripes","username":"kenderroni","nickname":"Texas Spotted Whiptail"},{"comment":"Dark \"boxing glove\" pedipalps are characteristic of a mature male in this species,","username":"Evantomology","nickname":"Striped Lynx Spider"},{"comment":"Wings are a uniform deep orange with a black border. The forewings have white spots that are not within a black border.","username":"VeeHobbins","nickname":"Queen"},{"comment":"It has the characteristic white spots and patterns of a Queen butterfly","username":"Hammyrrh","nickname":"Queen"},{"comment":"The orange stripe patterns behind the head, with one large followed by two smaller stripes look correct. General colors look correct, and range makes sense.","username":"superblenderbee","nickname":"American Bird Grasshopper"},{"comment":"looks very similar to iNaturalist photos, thank you for the great description roxorzboxorz31!","username":"sambanana1","nickname":"Four-spurred Assassin Bug"},{"comment":"Snatched waist! In science terms: it has the large mandibles, that bulky squareish section near the top, then a thin waist that leads into a large abdomen","username":"aristophat1203","nickname":"Scarites"},{"comment":"BIG FAT AND FLUFFY!!! fat fluffy yellow bits all along the back! so cute","username":"kosmocracy","nickname":"Sonoran Bumble Bee"},{"comment":"Orangy/brown and green wings White and brown squiggly line running through the wings.","username":"pheebo100","nickname":"Juniper Hairstreak"},{"comment":"Has the same body shape and leg consistency plus the tiny spikes on legs.","username":"Mortalized","nickname":"Lynx Spiders"},{"comment":"It has a dark redish brown color and black boarders on its wings with white speckles.","username":"MossyChat","nickname":"Queen"},{"comment":"Dark antennal tips separate this from other similar Polistes sp in the area","username":"Evantomology","nickname":"Hunter's Little Paper Wasp"},{"comment":"It appears to have the black underside on the thorax with the yellow on top and the rest of the black banding looks consistent with this species","username":"Omnicron77","nickname":"Sonoran Bumble Bee"},{"comment":"Danaus sp. with front and hind wings the same color underneath. White along wing veins on the under side.","username":"Evantomology","nickname":"Queen"},{"comment":"The brown/golden color along with the black border on the wings that have white spots.","username":"simplysomedj","nickname":"Queen"},{"comment":"The two white spots on the underside of the wing, closer to the body is unique among the green hairstreaks found in Texas. Also the most common species in the area","username":"Evantomology","nickname":"Juniper Hairstreak"},{"comment":"Yellow underbelly, black top, black wings with white spot on the bottom of the wings","username":"p1lague","nickname":"Lesser Goldfinch"},{"comment":"found in texas, is spiny, has coloration and markings similar to the texas spiny lizard in inat","username":"jorjedakota","nickname":"Texas Spiny Lizard"},{"comment":"patterns seem to match with sonoran more than southern plains- granted its hard to tell exactly with bluriness","username":"kamithedeus","nickname":"Sonoran Bumble Bee"},{"comment":"small narrow body, long antennae with nubs at the end, four wings... it matches inat pics","username":"jorjedakota","nickname":"Macleay's Owlfly"},{"comment":"Dorsally flat (flattened like if it was laying on its side not from the top)","username":"vickysm19","nickname":"Cixiid planthoppers"},{"comment":"Red eyes, slanted face, long antennae. Cerci on the tip of the abdomen bright yellow","username":"Evantomology","nickname":"Long-spurred Meadow Katydid"}],"suggestions":[{"nickname":"California Bordered Plant Bug","name":"California Bordered Plant Bug","username":"kay_online_","url":"https://census-storage.alveus.gg/4b6a280b-9968-430f-85fa-62edfb6d29a1.jpg","width":3840,"height":2160,"boundingBox":{"id":"18d84e5f-e970-4fbc-904b-94dbbcbd040c","x":2110,"y":142,"width":851,"height":994}},{"nickname":"Scudder's Bush Katydids","name":"Scudder's Bush Katydids","username":"roxorzboxorz31","url":"https://census-storage.alveus.gg/e7e0f27c-102a-40a3-bf07-1edc23c778b6.jpg","width":3840,"height":2160,"boundingBox":{"id":"48c9e8ad-18e8-465e-b879-3365300d9d73","x":1329,"y":815,"width":837,"height":665}},{"nickname":"Sonoran Bumble Bee","name":"Sonoran Bumble Bee","username":"itsbig_al","url":"https://census-storage.alveus.gg/b1d95e5d-01a1-419d-ab45-3841a310beb3.jpg","width":3840,"height":2160,"boundingBox":{"id":"2ef738b8-ee34-43e9-aaea-4b973f4780a0","x":1014,"y":812,"width":1140,"height":1176}},{"nickname":"fuscatus-group Paper Wasps","name":"fuscatus-group Paper Wasps","username":"yalmah","url":"https://census-storage.alveus.gg/393f3002-f643-4fc7-87a0-2c041f736cb7.jpg","width":3840,"height":2160,"boundingBox":{"id":"ef255742-4d17-4644-9ea8-0c7f121f96e0","x":741,"y":968,"width":1296,"height":1192}},{"nickname":"Ruby-throated and Black-chinned Hummingbirds","name":"Ruby-throated and Black-chinned Hummingbirds","username":"Evantomology","url":"https://census-storage.alveus.gg/cfcb852e-3c42-4e10-8bc6-0cd279e2f11d.jpg","width":3840,"height":2160,"boundingBox":{"id":"b35fb086-35cf-4fd9-855b-355a02d76ab0","x":1697,"y":